{
  "name": "node-ts-functional",
  "version": "1.0.0",
  "main": "server.js",
  "private": true,
  "author": "seaflux",
  "license": "ISC",
  "scripts": {
    "tsc": "tsc",
    "dev": "ts-node-dev --respawn -r tsconfig-paths/register --transpile-only src/index.ts",
    "start": "tsc && tsc-alias && node dist",
    "build": "tsc && tsc-alias",
    "prepare": "husky",
    "format": "biome check --write src/",
    "lint": "biome lint --error-on-warnings src/",
    "liquibase": "cd liquibase && liquibase update",
    "liquibase-clear-checksums": "cd liquibase && liquibase clear-checksums",
    "liquibase-rollback": "cd liquibase && liquibase --changeLogFile=changelog.xml rollbackCount 1",
    "liquibase-dev": "cd liquibase && liquibase update --defaultsFile=./liquibase-dev.properties",
    "liquibase-dev-rollback": "cd liquibase && liquibase --defaultsFile=./liquibase-dev.properties rollbackCount 1",
    "liquibase-stage": "cd liquibase && liquibase update --defaultsFile=./liquibase-stage.properties",
    "liquibase-stage-rollback": "cd liquibase && liquibase --defaultsFile=./liquibase-stage.properties rollbackCount 1",
    "liquibase-prod": "cd liquibase && liquibase update --defaultsFile=./liquibase-prod.properties",
    "liquibase-prod-rollback": "cd liquibase && liquibase --defaultsFile=./liquibase-prod.properties rollbackCount 1",
    "test": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/streamifier": "^0.1.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.17",
    "method-override": "^3.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "mysql2": "^3.18.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "streamifier": "^0.1.1",
    "typeorm": "^0.3.26",
    "winston": "^3.14.2",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
