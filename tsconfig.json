{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "allowJs": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/types/types.ts"],
  "exclude": [
    "node_modules",
    "src/__test__",
    "**/*.test.ts"
  ]
}